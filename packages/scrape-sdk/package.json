{
  "name": "scrape-sdk",
  "version": "0.3.0",
  "description": "TypeScript client to scrape URLs to markdown with failover across Firecrawl, TinyFish, Jina, Tavily, Spider, Browserbase, and local Cheerio",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "scrape-sdk": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./firecrawl": {
      "types": "./dist/adapters/firecrawl.d.ts",
      "import": "./dist/adapters/firecrawl.js",
      "default": "./dist/adapters/firecrawl.js"
    },
    "./jina": {
      "types": "./dist/adapters/jina.d.ts",
      "import": "./dist/adapters/jina.js",
      "default": "./dist/adapters/jina.js"
    },
    "./tavily": {
      "types": "./dist/adapters/tavily.d.ts",
      "import": "./dist/adapters/tavily.js",
      "default": "./dist/adapters/tavily.js"
    },
    "./spider": {
      "types": "./dist/adapters/spider.d.ts",
      "import": "./dist/adapters/spider.js",
      "default": "./dist/adapters/spider.js"
    },
    "./browserbase": {
      "types": "./dist/adapters/browserbase.d.ts",
      "import": "./dist/adapters/browserbase.js",
      "default": "./dist/adapters/browserbase.js"
    },
    "./tinyfish": {
      "types": "./dist/adapters/tinyfish.d.ts",
      "import": "./dist/adapters/tinyfish.js",
      "default": "./dist/adapters/tinyfish.js"
    },
    "./local": {
      "types": "./dist/adapters/local.d.ts",
      "import": "./dist/adapters/local.js",
      "default": "./dist/adapters/local.js"
    },
    "./ai": {
      "types": "./dist/ai/index.d.ts",
      "import": "./dist/ai/index.js",
      "default": "./dist/ai/index.js"
    }
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json",
    "test": "tsc -p tsconfig.test.json && node --test .test-dist/client.test.js .test-dist/adapters.test.js .test-dist/ai.test.js .test-dist/tinyfish.test.js .test-dist/firecrawl-keyless.test.js .test-dist/from-env.test.js",
    "typecheck": "tsc --noEmit -p tsconfig.test.json"
  },
  "keywords": [
    "scraper",
    "web-scraping",
    "crawler",
    "markdown",
    "firecrawl",
    "tinyfish",
    "jina",
    "tavily",
    "ai-agents",
    "mcp",
    "agent-skills",
    "vercel-ai-sdk"
  ],
  "author": "Arush Wadhawan <https://x.com/be_arsh>",
  "license": "MIT",
  "dependencies": {
    "cheerio": "^1.0.0",
    "turndown": "^7.2.0",
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "ai": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/turndown": "^5.0.5",
    "typescript": "^5.5.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SoulSniper-V2/scrape-sdk.git",
    "directory": "packages/scrape-sdk"
  },
  "homepage": "https://www.scrape-sdk.com",
  "bugs": {
    "url": "https://github.com/SoulSniper-V2/scrape-sdk/issues"
  },
  "files": [
    "dist",
    "README.md"
  ]
}
