{
  "name": "scrape-sdk-mcp",
  "version": "0.3.0",
  "description": "MCP server for scrape-sdk — full-page scrape, search, extraction, and optional goal-based web agents with provider failover.",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "scrape-sdk-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --packages=external",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.2",
    "scrape-sdk": "^0.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "esbuild": "^0.25.8",
    "typescript": "^5.5.4"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "mcp",
    "scrape-sdk",
    "web-scraping",
    "markdown",
    "firecrawl",
    "tinyfish",
    "claude",
    "cursor"
  ],
  "author": "Arush Wadhawan <https://x.com/be_arsh>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SoulSniper-V2/scrape-sdk",
    "directory": "packages/mcp-server"
  },
  "homepage": "https://www.scrape-sdk.com/docs/guides/model-context-protocol",
  "bugs": {
    "url": "https://github.com/SoulSniper-V2/scrape-sdk/issues"
  }
}
