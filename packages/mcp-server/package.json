{
  "name": "scrape-sdk-mcp",
  "version": "0.2.0",
  "description": "MCP server for scrape-sdk — web_fetch, web_search, map_site, crawl_site, extract_json over stdio",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "scrape-sdk-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --packages=external",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.2",
    "scrape-sdk": "*",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "esbuild": "^0.25.8",
    "typescript": "^5.5.4"
  },
  "files": [
    "dist"
  ],
  "license": "MIT"
}
